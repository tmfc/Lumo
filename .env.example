# Slack 相关（必填）
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# LiteLLM（必填：用哪个模型）
LITELLM_MODEL=gpt-5-mini
LITELLM_BASE_URL=https://your-litellm-gateway.com
LITELLM_API_KEY=your-litellm-gateway-api-key

# 总结时最多拉取的消息数量（可根据需要调整）
SLACK_SUMMARY_MAX_MESSAGES=100

# LiteLLM 对应厂商的 API Key（根据你选的模型配置，示例为 OpenAI）
# 具体变量名请参考 LiteLLM 文档
OPENAI_API_KEY=your-openai-api-key-here

# Qdrant API Key（如自建向量库并启用鉴权，可选）
QDRANT_API_KEY=your-qdrant-api-key-here

# Qdrant 服务地址（包含协议和端口），本地 docker-compose 默认如下
QDRANT_URL=http://127.0.0.1:6333

# Qdrant 集合名称（可选），不配置则默认使用 lumo_slack_documents
# QDRANT_COLLECTION=lumo_slack_documents

# 文档管理接口的管理员密码
ADMIN_PASSWORD=your-secret-password